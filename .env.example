# Local-only credentials. Change the password before exposing services beyond localhost.
POSTGRES_DB=clinical_trials
POSTGRES_USER=clinical_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ClinicalTrials.gov API query controls
CTG_QUERY_CONDITION=lymphoma
CTG_PAGE_SIZE=250
CTG_MAX_STUDIES=1000

# Local Metabase port
METABASE_PORT=3000
